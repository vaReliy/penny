{
  "name": "budget-infrastructure",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/budget/infrastructure/src",
  "projectType": "library",
  "tags": ["scope:budget", "type:infrastructure", "platform:server"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/budget/infrastructure",
        "main": "libs/budget/infrastructure/src/index.ts",
        "tsConfig": "libs/budget/infrastructure/tsconfig.lib.json",
        "assets": ["libs/budget/infrastructure/*.md"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/budget/infrastructure",
        "command": "vitest"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/budget/infrastructure",
        "command": "tsc --noEmit -p tsconfig.spec.json"
      }
    }
  }
}
