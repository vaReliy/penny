{
  "name": "budget-validation",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/budget/validation/src",
  "projectType": "library",
  "tags": ["scope:budget", "type:validation", "platform:shared"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/budget/validation",
        "main": "libs/budget/validation/src/index.ts",
        "tsConfig": "libs/budget/validation/tsconfig.lib.json",
        "assets": []
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/budget/validation",
        "command": "tsc --noEmit -p tsconfig.spec.json"
      }
    }
  }
}
