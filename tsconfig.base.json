{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "shared-errors": ["./libs/shared/errors/src/index.ts"],
      "shared-util": ["./libs/shared/util/src/index.ts"],
      "shared-contracts": ["./libs/shared/contracts/src/index.ts"],
      "shared-kernel": ["./libs/shared/kernel/src/index.ts"],
      "shared-validation": ["./libs/shared/validation/src/index.ts"],
      "shared-infrastructure": ["./libs/shared/infrastructure/src/index.ts"],
      "identity-core": ["./libs/identity/core/src/index.ts"],
      "identity-application": ["./libs/identity/application/src/index.ts"],
      "identity-infrastructure": [
        "./libs/identity/infrastructure/src/index.ts"
      ],
      "identity-feature-login": ["./libs/identity/feature-login/src/index.ts"],
      "identity-data-access": ["./libs/identity/data-access/src/index.ts"],
      "identity-feature-access-status": [
        "./libs/identity/feature-access-status/src/index.ts"
      ],
      "identity-feature-greeting": [
        "./libs/identity/feature-greeting/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
