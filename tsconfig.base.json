{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "shared-errors": ["./libs/shared/errors/src/index.ts"],
      "shared-util": ["./libs/shared/util/src/index.ts"],
      "shared-contracts": ["./libs/shared/contracts/src/index.ts"],
      "shared-kernel": ["./libs/shared/kernel/src/index.ts"],
      "identity-core": ["./libs/identity/core/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
