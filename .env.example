# Environment variables for penny Docker Compose setup
# Copy this file to .env and fill in actual values before running docker compose

# MongoDB configuration
# The database name used by the API and CLI
MONGO_DB_NAME=penny

# MongoDB authentication credentials
MONGO_USER=penny-user
MONGO_PASSWORD=your-secure-mongo-password-change-me

# Full MongoDB connection URI — required by the CLI when run outside Docker.
# docker-compose constructs this automatically; set it manually for local CLI usage.
# Example for local Docker Compose: mongodb://penny-user:password@localhost:27017/penny?authSource=admin
MONGO_URI=mongodb://${MONGO_USER}:${MONGO_PASSWORD}@localhost:27017/${MONGO_DB_NAME}?authSource=admin

# MongoDB URI used by integration tests (e.g. libs/identity/infrastructure specs).
# Reuses the same credentials against a separate test database so tests never touch
# the dev database. Requires `docker compose up -d mongo` to be running locally.
MONGO_TEST_URI=mongodb://${MONGO_USER}:${MONGO_PASSWORD}@localhost:27017/penny-test?authSource=admin

# JWT and Telegram Bot configuration (required by API)
# JWT_SECRET: secret key for signing JWT tokens (use a strong random value in production)
JWT_SECRET=your-jwt-secret-key-change-me

# TELEGRAM_BOT_TOKEN: bot token from Telegram BotFather (required for Telegram Login integration)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-change-me

# TELEGRAM_BOT_USERNAME: public username of the bot (without @), e.g. mypennybot
# Used by the Angular web app at Docker build time (passed as --build-arg by docker compose)
TELEGRAM_BOT_USERNAME=your-telegram-bot-username-change-me

# Optional: Node environment (defaults to production in container)
# NODE_ENV=production
