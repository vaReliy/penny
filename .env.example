# Environment variables for penny Docker Compose setup
# Copy this file to .env and fill in actual values before running docker compose

# MongoDB configuration
# The database name used by the API and CLI
MONGO_DB_NAME=penny

# MongoDB authentication credentials
MONGO_USER=penny-user
MONGO_PASSWORD=your-secure-mongo-password-change-me

# JWT and Telegram Bot configuration (required by API)
# JWT_SECRET: secret key for signing JWT tokens (use a strong random value in production)
JWT_SECRET=your-jwt-secret-key-change-me

# TELEGRAM_BOT_TOKEN: bot token from Telegram BotFather (required for Telegram Login integration)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-change-me

# Optional: Node environment (defaults to production in container)
# NODE_ENV=production
